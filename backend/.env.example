# Supabase project settings (Settings > API in your Supabase dashboard)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Port the Express server runs on locally (Render sets its own PORT)
PORT=5000

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:5173,https://your-app.pages.dev
